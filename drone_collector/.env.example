# drone_collector/.env.example -- copy to drone_collector/.env and fill in.
#
# NEVER commit a real .env. The repository .gitignore already ignores `.env`
# at any level, and drone_collector/.gitignore repeats it next to this file.
#
# This file contains placeholders only. Do not put real values here.

# ─── DJI SmartFarm ────────────────────────────────────────────────────────────

# Records page opened by the collector. The list view is required: in map mode
# the site only fetches /flight_records/overview and no flight list is ever
# returned.
DJI_RECORDS_URL=https://www.djiag.com/records/list

# Saved browser session written by `--save-session`. Relative paths are
# resolved against the drone_collector/ directory.
DJI_STORAGE_STATE=data/storage_state.json

# Headless Chromium. Keep `false` until the run is known to work on the
# server: a headful window is the only way to see what the site is doing.
DJI_HEADLESS=false

# Size of the rolling window for scheduled runs, in days, inclusive of today.
DJI_WINDOW_DAYS=30

# Local timezone used for the window edges. The business reads flights in
# UTC+5; the same offset is used by the application (drones.py).
DJI_TZ_OFFSET_HOURS=5

# Per-navigation timeout, milliseconds.
DJI_PAGE_TIMEOUT_MS=45000

# Wait after each UI action (date typed, page clicked), milliseconds.
DJI_SETTLE_MS=2500

# Hard safety cap on pagination iterations. A run that hits it stops and is
# reported as incomplete rather than looping forever. 2000, not 500: the live
# cabinet reports 705 pages for 2026-01-01..2026-07-31 at 30 per page, and a
# full historical window is around 970, so 500 would have terminated a
# legitimate backfill as if it had run away.
DJI_MAX_PAGES=2000

# Substring the region shown on the page must contain, compared
# case-insensitively before the period is set. No default: leave it empty and
# the check is skipped. A wrong region returns an empty flight list with no
# error at all, which is the most dangerous silent failure in this
# integration. If the region element cannot be found the run only warns -- the
# selector has never been confirmed on the live cabinet.
DJI_EXPECTED_REGION=

# A window that captures zero flights normally fails the run (exit 6), because
# the usual cause is a session switched to another region. Set this to true
# only for a period that really is empty.
DJI_ALLOW_EMPTY_WINDOW=false

# ─── Vehicle Soft ingest ──────────────────────────────────────────────────────

# Base URL of the Vehicle Soft application. The collector appends
# /drones/api/flight_sync itself.
VEHICLE_SOFT_BASE_URL=http://10.103.25.200:5050

# Ingest token. Must equal DRONE_API_TOKEN of the Vehicle Soft service.
# Placeholder only -- never write the real token into this example file.
DRONE_API_TOKEN=put_the_real_token_in_dot_env_not_here

# Flights per POST. Clamped to 1000 in code regardless of what is set here,
# because the endpoint answers 413 above that -- and 1000 is also the default,
# because the endpoint writes one drone_sync_logs row per request and smaller
# batches turn "did the backfill succeed" into a manual summing exercise.
DRONE_BATCH_SIZE=1000
