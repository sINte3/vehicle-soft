# Database — NEVER commit production data
instance/transport.db
instance/transport.db.backup*
instance/old_transport.db
old_transport.db

# Generated reports
reports/*.xlsx
reports/*.xls

# Logs
logs/*.log
logs/*.txt

# Historical release archives (replaced by git history)
Archive/

# Environment variables and secrets
.env

# Python runtime artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Binary tools — download separately from https://nssm.cc/download
nssm.exe

# Windows desktop artifacts
Thumbs.db
Desktop.ini

# IDE project files
.vscode/
.idea/
*.swp
*.swo

# Claude Code agent session and memory files (not project source)
.claude/

# One-time migration and fix script log output (runtime artifacts, not source)
migration_log_*.csv
fix_names_log_*.csv
patch2_log_*.csv

# Root-level binary reference import file (not version-controlled source)
/Agroklastr_Tehnika_Konsolidaciya.xlsx
/Агрокластер_Техника_Консолидация.xlsx

# Old backup copies of modules no longer in active use.
# wialon_import_v3.py is excluded because it contains a stale hardcoded API token
# (real value redacted; see docs/SECRET_SCAN_REPORT.md) from before TASK-SEC-002.
# The active module is wialon_import.py.
/wialon_import_v3.py

# Root-level orphaned HTML files (old copies; active templates are in templates/)
/wialon.html
/wialon_auto_match.html
/wialon_report_v2.html

# Local Claude/ChatGPT handoff prompts (working artifacts, not source)
/PROMPT_*.md
/PROMPT.md
*.docx
# Local runtime data
instance/
logs/
*.db
*.sqlite
*.sqlite3
*.log
*.pyc

schema.txt

# DRONE-WORKS-UPLOAD-001: the dispatchers' books uploaded through the screen.
# They are kept on disk next to the database -- the importer has been repaired
# once already and without the originals re-parsing the past is impossible --
# but they are operational data, Cyrillic-named and up to 25 MB each. The
# `instance/` rule above already covers the default location; this rule covers
# the directory by NAME, so moving the database does not silently start
# committing books.
drone_work_books/

drone_verify_007_*.txt

# docs/archive/ -- our archive, not a build artefact. The Archive/ rule above
# matches it and would hide anything newly added there, without a word.
!docs/archive/
!docs/archive/**

# tools/ux/ -- dev-only UX audit tooling (Playwright, axe-core). Node modules
# are never committed; package.json and package-lock.json are. This directory
# is NOT an application dependency: requirements.txt stays untouched.
tools/ux/node_modules/

# Read-only metrics export produced by tools/ux/collect_metrics.py. Contains no
# field values, but it is a regenerable artefact of a specific database, so it
# lands under docs/ux/10-metrics/ by hand, not from the repository root.
/ux_metrics.json
